# --- PawSOS FastAPI & PostgreSQL Configuration ---

# PostgreSQL connection string through Supabase:
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# JWT Authentication
JWT_SECRET_KEY="replace-this-with-a-secure-32-character-random-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="10080"

# Supabase Storage Integration
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_KEY="your-supabase-service-role-or-anon-key"
SUPABASE_STORAGE_BUCKET="animal-rescue-photos"

# Application Environment
ENVIRONMENT="production"
PORT=8000
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://your-domain.com"
